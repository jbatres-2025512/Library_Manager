# Copy to .env and adjust. Never commit the real .env file.
SERVER_PORT=8081

DB_URL=jdbc:postgresql://localhost:5432/db_library
DB_USERNAME=postrgres
DB_PASSWORD=admin
DB_POOL_SIZE=30

# Minimum 32 characters (HS256). Generate with: openssl rand -base64 48
JWT_SECRET=change_me_to_a_long_random_secret_of_at_least_32_chars
JWT_EXPIRATION_MS=3600000

TOMCAT_MAX_THREADS=300
